{
  "name": "bdd-trial-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Throwaway TypeScript CLI that proves the autonomous planning-and-delivery workflow end to end.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:bdd",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:bdd": "node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
